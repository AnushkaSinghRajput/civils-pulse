// CivilsPulse — MVP schema
// Domains: Identity | Content (PYQ) | Assessment | Analytics | Audit
// Principle: every published question has provenance + human verification

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity & multi-tenant ───────────────────────────────────────────────

enum Role {
  STUDENT
  ADMIN
  INSTITUTION_ADMIN
}

enum Plan {
  FREE
  PRO
  INSTITUTION
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(STUDENT)
  plan          Plan      @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  mockAttempts  MockAttempt[]
  verifications QuestionVerification[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([plan])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(INSTITUTION)
  seatLimit Int      @default(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]

  @@index([slug])
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(STUDENT)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// ─── Content: official sources & PYQs ──────────────────────────────────────

enum ExamType {
  PRELIMS
  MAINS
  INTERVIEW
}

enum PaperCode {
  PRELIMS_GS1
  PRELIMS_CSAT
  MAINS_GS1
  MAINS_GS2
  MAINS_GS3
  MAINS_GS4
  MAINS_ESSAY
  INTERVIEW
}

enum Language {
  EN
  HI
}

enum VerificationStatus {
  EXTRACTED // raw from ingestion — never shown to students
  IN_REVIEW
  APPROVED // published to students
  REJECTED
  NEEDS_FIX
}

enum ContentKind {
  OFFICIAL_PYQ
  GENERATED_PRACTICE // must be labeled distinctly in UI
}

model SourceDocument {
  id              String    @id @default(cuid())
  title           String
  year            Int
  examType        ExamType
  paper           PaperCode
  language        Language
  officialPdfUrl  String // original UPSC PDF URL — never drop this
  checksum        String?
  pageCount       Int?
  ingestionJobId  String?
  extractedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  questions Question[]

  @@unique([year, paper, language, officialPdfUrl])
  @@index([year, paper])
}

model Topic {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  subject     String // e.g. Polity, Economy, History
  description String?
  parentId    String?
  parent      Topic?     @relation("TopicTree", fields: [parentId], references: [id])
  children    Topic[]    @relation("TopicTree")
  questions   QuestionTopic[]
  createdAt   DateTime   @default(now())

  @@index([subject])
  @@index([parentId])
}

model Question {
  id                   String             @id @default(cuid())
  sourceDocumentId     String?
  year                 Int
  examType             ExamType
  paper                PaperCode
  subject              String?
  questionNumber       Int?
  language             Language           @default(EN)
  kind                 ContentKind        @default(OFFICIAL_PYQ)
  stem                 String             @db.Text
  optionA              String?            @db.Text
  optionB              String?            @db.Text
  optionC              String?            @db.Text
  optionD              String?            @db.Text
  correctOption        String? // A|B|C|D for Prelims MCQ
  explanation          String?            @db.Text
  officialSourceUrl    String // provenance: official PDF (or page) URL
  sourceMetadata       Json? // page, bbox, extractor version, etc.
  extractionConfidence Float? // 0–1 from ingestion pipeline
  verificationStatus   VerificationStatus @default(EXTRACTED)
  publishedAt          DateTime?
  // Full-text: add tsvector + GIN via SQL migration (prisma/sql/fts.sql)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  sourceDocument SourceDocument?         @relation(fields: [sourceDocumentId], references: [id])
  topics         QuestionTopic[]
  verifications  QuestionVerification[]
  attemptAnswers AttemptAnswer[]
  pairedQuestionId String?   @unique
  pairedQuestion   Question? @relation("BilingualPair", fields: [pairedQuestionId], references: [id])
  pairOf           Question? @relation("BilingualPair")

  @@index([year, paper, language])
  @@index([verificationStatus, publishedAt])
  @@index([examType, paper])
  @@index([kind])
}

model QuestionTopic {
  questionId String
  topicId    String
  isPrimary  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([questionId, topicId])
  @@index([topicId])
}

model QuestionVerification {
  id          String             @id @default(cuid())
  questionId  String
  reviewerId  String
  fromStatus  VerificationStatus
  toStatus    VerificationStatus
  notes       String?            @db.Text
  checklist   Json? // stem/options/answer/source URL checked
  createdAt   DateTime           @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reviewer User     @relation(fields: [reviewerId], references: [id])

  @@index([questionId, createdAt])
  @@index([reviewerId])
}

// ─── Assessment: Prelims mock engine ───────────────────────────────────────

enum MockMode {
  FULL_LENGTH
  TOPIC_WISE
  CUSTOM
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
  EXPIRED
}

model MockTemplate {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  description     String?
  mode            MockMode @default(FULL_LENGTH)
  paper           PaperCode @default(PRELIMS_GS1)
  questionCount   Int
  durationMinutes Int
  negativeMarking Float    @default(0.66) // UPSC Prelims GS: −1/3 of marks
  marksPerQuestion Float   @default(2)
  yearFilter      Int[]    @default([])
  topicIds        String[] @default([])
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attempts MockAttempt[]
}

model MockAttempt {
  id              String        @id @default(cuid())
  userId          String
  templateId      String?
  mode            MockMode
  paper           PaperCode
  status          AttemptStatus @default(IN_PROGRESS)
  questionIds     String[] // ordered snapshot — immutable once started
  startedAt       DateTime      @default(now())
  endsAt          DateTime // server-authoritative deadline
  submittedAt     DateTime?
  durationMinutes Int
  negativeMarking Float
  marksPerQuestion Float
  // Deterministic score fields (filled on submit)
  correctCount    Int?
  incorrectCount  Int?
  unansweredCount Int?
  rawScore        Float?
  maxScore        Float?
  negativeImpact  Float?
  scorePayload    Json? // full reproducible breakdown
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template MockTemplate? @relation(fields: [templateId], references: [id])
  answers  AttemptAnswer[]

  @@index([userId, status])
  @@index([templateId])
  @@index([startedAt])
}

model AttemptAnswer {
  id              String   @id @default(cuid())
  attemptId       String
  questionId      String
  selectedOption  String? // A|B|C|D or null
  isCorrect       Boolean?
  timeSpentMs     Int      @default(0)
  markedForReview Boolean  @default(false)
  answeredAt      DateTime?
  updatedAt       DateTime @updatedAt

  attempt  MockAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// ─── Basic analytics (MVP) ─────────────────────────────────────────────────

model UserTopicStat {
  id             String   @id @default(cuid())
  userId         String
  topicId        String
  attempted      Int      @default(0)
  correct        Int      @default(0)
  incorrect      Int      @default(0)
  accuracy       Float    @default(0)
  lastAttemptAt  DateTime?
  updatedAt      DateTime @updatedAt

  @@unique([userId, topicId])
  @@index([userId, accuracy])
}

// ─── Audit ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
